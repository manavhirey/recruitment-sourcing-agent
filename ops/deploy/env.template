# Template for per-environment .env files on the VPS.
# Copy to /opt/recruitment/<dev|prod>/.env and fill every <...> placeholder.
# Generate secrets with: openssl rand -base64 32   (AUTH_SECRET: openssl rand -base64 32 | tr '+/' '-_' | head -c 43)

# --- Deployment (used by ops/deploy/compose.ghcr.yml) ---
ENV_NAME=dev
API_HOST=dev-api.kunigami.cloud
WEB_HOST=dev.kunigami.cloud
API_PUBLIC_URL=https://dev-api.kunigami.cloud
WEB_PUBLIC_URL=https://dev.kunigami.cloud
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Stack (mirrors .env.example) ---
ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<random>
POSTGRES_DB=sourcing
COMPOSE_DATABASE_URL=postgresql+psycopg://sourcing_api:<api-db-password>@postgres:5432/sourcing
COMPOSE_MAINTENANCE_DATABASE_URL=postgresql+psycopg://sourcing_maintenance:<maintenance-db-password>@postgres:5432/sourcing
COMPOSE_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<same-as-POSTGRES_PASSWORD>@postgres:5432/sourcing
COMPOSE_REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=<random>
MINIO_ROOT_PASSWORD=<random>
OBJECT_STORE_ENDPOINT=http://minio:9000
COMPOSE_OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=provider-snapshots
OBJECT_STORE_WRITER_ACCESS_KEY_ID=<random>
OBJECT_STORE_WRITER_SECRET_ACCESS_KEY=<random>
OBJECT_STORE_DELETE_ACCESS_KEY_ID=<random>
OBJECT_STORE_DELETE_SECRET_ACCESS_KEY=<random>
OIDC_ISSUER=https://auth.kunigami.cloud/realms/sourcing
OIDC_AUDIENCE=https://dev-api.kunigami.cloud
OIDC_CLIENT_ID=sourcing-web-dev
OIDC_CLIENT_SECRET=<from keycloak>
OPENAI_API_KEY=<optional-dev-key>
SCORECARD_MODEL=gpt-5-mini
APOLLO_API_KEY=<optional-dev-key>
CONTACT_ENCRYPTION_KEY=<openssl rand -base64 32>
SUPPRESSION_HMAC_KEY=<random>
IDENTITY_HMAC_KEY=<random>
IDENTITY_HMAC_KEY_VERSION=v1
TELEMETRY_HMAC_KEY=<random>
WEBHOOK_HMAC_KEY=<random>
WEBHOOK_BASE_URL=https://dev-api.kunigami.cloud
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_REVEAL_PHONE_NUMBERS=false
TRUSTED_PROXY_IPS=<traefik-proxy subnet, e.g. 172.28.0.0/16>
AUTH_URL=https://dev.kunigami.cloud
AUTH_SECRET=<43+ random base64url chars>
ENABLE_DEV_AUTH_OVERRIDE=false
OIDC_AUDIENCE_COMPATIBILITY=false
API_BASE_URL=https://dev-api.kunigami.cloud
TENANT_OPTIONS=[]
