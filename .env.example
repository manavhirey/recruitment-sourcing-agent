POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sourcing
DATABASE_URL=postgresql+psycopg://sourcing_api:replace-with-api-password@localhost:5432/sourcing
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sourcing
MAINTENANCE_DATABASE_URL=postgresql+psycopg://sourcing_maintenance:replace-with-maintenance-password@localhost:5432/sourcing
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=provider-snapshots
OBJECT_STORE_WRITER_ACCESS_KEY_ID=replace-with-runtime-write-only-key
OBJECT_STORE_WRITER_SECRET_ACCESS_KEY=replace-with-runtime-write-only-secret
OBJECT_STORE_DELETE_ACCESS_KEY_ID=replace-with-maintenance-delete-only-key
OBJECT_STORE_DELETE_SECRET_ACCESS_KEY=replace-with-maintenance-delete-only-secret
OBJECT_STORE_LIFECYCLE_ADMIN_ACCESS_KEY_ID=replace-with-lifecycle-admin-key
OBJECT_STORE_LIFECYCLE_ADMIN_SECRET_ACCESS_KEY=replace-with-lifecycle-admin-secret
OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=https://api.sourcing.example.com
OPENAI_API_KEY=replace-with-development-key
SCORECARD_MODEL=gpt-5-mini
APOLLO_API_KEY=replace-with-development-key
CONTACT_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SUPPRESSION_HMAC_KEY=replace-with-development-key
TELEMETRY_HMAC_KEY=replace-with-distinct-development-key
WEBHOOK_HMAC_KEY=replace-with-development-key
WEBHOOK_BASE_URL=https://api.example.com
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_REVEAL_PHONE_NUMBERS=false
TRUSTED_PROXY_IPS=127.0.0.1
AUTH_URL=https://sourcing.example.com
AUTH_SECRET=replace-with-at-least-43-random-base64url-characters
OIDC_AUDIENCE_COMPATIBILITY=false
OIDC_CLIENT_ID=sourcing-web
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
API_BASE_URL=https://api.sourcing.example.com
TENANT_OPTIONS=[]
